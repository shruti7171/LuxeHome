# LuxeHome Full-Stack Configuration
# Set PORT for the unified server
PORT=5000

# Set NODE_ENV to production
NODE_ENV=production

# Database Configuration (supports individual variables or DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=luxehome
DB_SSL=false

# Or use standard Cloud Database Connection URL:
# DATABASE_URL=mysql://user:password@host:3306/luxehome?ssl=true

# Allowed CORS origins for standalone frontend deployments (e.g. Vercel)
# CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# Frontend API URL (leave empty for same-origin unified deployment or set for decoupled)
# VITE_API_URL=https://your-backend.onrender.com
